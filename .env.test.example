# Playwright E2E test environment
# Copy to .env.test and fill in real values

# Frontend URL (default: http://localhost:5173)
BASE_URL=http://localhost:5173

# Backend API URL — used by global.setup.ts to call /api/auth/login directly
# Use 127.0.0.1 (not localhost) on Windows to avoid IPv6 ::1 connection refused
API_BASE=http://127.0.0.1:3000

# Admin credentials for global setup (creates .playwright/auth/admin.json)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
