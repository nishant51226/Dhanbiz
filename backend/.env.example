PORT=3000

# Base URL for links embedded in Excel exports (must be reachable from the machine opening the spreadsheet).
# Example: http://192.168.1.10:3000 or https://api.yourdomain.com
# APP_PUBLIC_API_ORIGIN=http://127.0.0.1:3000

# --- Swagger / OpenAPI ---
# Running app: UI at http://localhost:PORT/api/docs, JSON at http://localhost:PORT/api/docs-json
# Export openapi/openapi.json (e.g. for Postman): npm run openapi:export (needs DATABASE_URL; optional OPENAPI_OUTPUT=path/to/file.json)

# --- Postgres ---
# RLS tenant debug (`[RLS_TENANT_DEBUG]` in logs) is always on in code; no env flag.
#
# DATABASE_URL is required for the Nest app. With RLS, prefer the least-privileged role (e.g. customer_app after migrations).
# DATABASE_URL=postgresql://customer_app:CHANGE_ME@127.0.0.1:5432/docp
# Simple local compose (one role): DATABASE_URL=postgresql://docp:docp@127.0.0.1:5432/docp
# Optional superuser/owner URL for DDL migrations and for pg-boss when elevated rights are needed. If unset, `npm run migrate` and the job queue use DATABASE_URL.
# DATABASE_URL_ADMIN=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/docp
# After build: run migrations once per deploy — `npm run migrate` (see package.json). The app does not auto-run migrations on startup.
# Optional connection pool tuning (defaults shown in app.module.ts).
# DB_POOL_MAX=20
# DB_POOL_IDLE_MS=30000
# DB_POOL_CONNECT_MS=5000

# Where uploaded blobs are stored (must exist and be writable)
FILE_STORAGE_ROOT=./data/files

# --- AWS S3 (optional; inject S3Service anywhere) ---
# S3Client is always constructed; when AWS_S3_BUCKET is unset, S3Service.isConfigured() is false and API methods throw ServiceUnavailableException.
# Credentials: standard AWS chain (env AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, instance profile, etc.).
# AWS_S3_BUCKET=
# AWS_REGION=eu-west-2
# Optional: MinIO / LocalStack / custom S3-compatible API
# AWS_S3_ENDPOINT=http://127.0.0.1:9000
# For many S3-compatible servers you must set path-style addressing:
# AWS_S3_FORCE_PATH_STYLE=true
#
# S3 object keys: `{customerId}/…` (no extra "customers/" prefix).
# On create: four onboarding PDFs → S3 `…/onboarding-files/01-….pdf` … `04-….pdf` + matching `files` rows (`s3_key`).
# Generic `POST /files/upload` also mirrors bytes to `…/files/uploads/{fileId}-{name}` when the bucket is set.
#   (Library invoices/statements use `documents`, not `files`.) Empty step JSON until completion sync overwrites.
# On onboarding completed: `…/onboarding-files/onboarding-data.json`, same four step PDFs (real data), `metadata.json`,
#   and `…/onboarding-files/files/{uuid}-{name}` for every `file:{uuid}` in data + metadata (needs FILE_STORAGE_ROOT).
# If AWS_S3_BUCKET is unset, S3 steps are skipped.

# PDF page rasterization for vision OCR: Win/Mac use bundled Poppler via npm `pdf-poppler`.
# Linux: install Poppler and ensure `pdftoppm` is on PATH (pdf-poppler does not bundle linux).

# --- DocuSeal (remote client registration signature by email) ---
# Create a template in DocuSeal and use its numeric template id. API key from DocuSeal → API.
# DOCUSEAL_API_KEY=
# DOCUSEAL_TEMPLATE_ID=1000001
# Optional: separate DocuSeal template for the change-of-accountant letter (numeric id). When unset, `DOCUSEAL_TEMPLATE_ID` is used.
# DOCUSEAL_TEMPLATE_ID_CHANGE_ACCOUNTANT=
# Must match a submitter role name on that template exactly (DocuSeal shows roles in the template editor).
# If this is wrong in practice, check a machine-level env var: Node/dotenv does not override variables already set in the process.
# Must match a submitter role name on the DocuSeal template exactly (e.g. First Party).
# DOCUSEAL_DEFAULT_SUBMITTER_ROLE=First Party
# Optional: override API host (self-hosted DocuSeal).
# DOCUSEAL_API_BASE_URL=https://api.docuseal.com
# Webhook URL (must be reachable FROM the DocuSeal server): POST {PUBLIC_URL}/api/webhooks/docuseal
# Also accepted (rewritten to /api/...): POST {PUBLIC_URL}/webhooks/docuseal
# ConnectionFailed in DocuSeal usually means DocuSeal (e.g. in Docker) used "localhost" for your API — inside the container
# that is the container itself. Use http://host.docker.internal:PORT (Win/Mac Docker→host) or your machine LAN IP, not localhost.
# Self-hosted DocuSeal + API on host: e.g. http://host.docker.internal:3009/api/webhooks/docuseal
# In DocuSeal Console → Webhooks → enable events form.completed and/or submission.completed.
# "Add secret" header NAME must match DOCUSEAL_WEBHOOK_SECRET_HEADER (default x-docuseal-webhook-secret); VALUE = DOCUSEAL_WEBHOOK_SECRET.
# DOCUSEAL_WEBHOOK_SECRET=use-openssl-rand-hex-32
# DOCUSEAL_WEBHOOK_SECRET_HEADER=x-docuseal-webhook-secret
# Comma-separated template field names used to locate the drawn signature image URL in webhook payloads.
# DOCUSEAL_SIGNATURE_FIELD_NAMES=Signature

# Comma-separated origins for CORS (empty = sensible dev defaults in main.ts)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001

# Optional: set all auth vars to require login (AUTH_SECRET min 16 chars). Omit for open local dev.
# If AUTH_* are set, every /api/* request (except /api/auth/status, /api/auth/login, /api/auth/refresh, /api/auth/logout) needs
# Authorization: Bearer <accessToken> from POST /api/auth/login — refresh via POST /api/auth/refresh with refreshToken.
# AUTH_USERNAME=admin
# AUTH_PASSWORD=change-me
# AUTH_SECRET=use-openssl-rand-hex-32
# UUID of an existing users.id row — required when env login is enabled (tryLogin issues a token for this user).
# AUTH_USER_ID=00000000-0000-4000-8000-000000000001
# Optional tenant scope: customers.id for RLS (omit for null customer scope).
# AUTH_CUSTOMER_ID=
# Recommended TTLs: access 15 min, refresh 7 days
# AUTH_ACCESS_TOKEN_TTL_SEC=900
# AUTH_REFRESH_TOKEN_TTL_SEC=604800
# Legacy: refresh TTL fallback only when AUTH_REFRESH_TOKEN_TTL_SEC is unset
# AUTH_TOKEN_TTL_SEC=604800

# Multi-provider: default when a job has no ai_provider set. UI lists only enabled providers.
# ollama | openai | bedrock | huggingface — falls back to first enabled if unset/invalid.
# AI_PROVIDER_DEFAULT=ollama

OLLAMA_HOST=http://127.0.0.1:11434
# Docker: set OLLAMA_MODELS in repo root .env (see .env.compose.example) so the ollama service pulls extra models.
# Vision / OCR: qwen2.5vl:3b OR glm-ocr (pull: ollama pull glm-ocr — smaller ~0.9B, good for documents/tables)
# For glm-ocr, prompts like "Text Recognition: …" or "Table Recognition: …" match upstream examples.
OLLAMA_VISION_MODEL=qwen2.5vl:3b
# OLLAMA_VISION_MODEL=glm-ocr
# OLLAMA_VISION_MODEL=glm-ocr:q8_0
# Text-only model for JSON structuring (pull separately, e.g. ollama pull qwen2.5:3b)
OLLAMA_STRUCTURE_MODEL=qwen2.5:3b
# Structure step: Ollama JSON mode + options (defaults match Qwen2.5 32k context; avoid huge num_predict on CPU)
# OLLAMA_STRUCTURE_NUM_CTX=32768
# OLLAMA_STRUCTURE_NUM_PREDICT=8192
# OLLAMA_STRUCTURE_TEMPERATURE=0
# Longer wait for structure only (optional; else OLLAMA_FETCH_TIMEOUT_MS)
# OLLAMA_STRUCTURE_FETCH_TIMEOUT_MS=900000
# Set to off only if Ollama is too old for structured outputs (no format=json)
# OLLAMA_STRUCTURE_FORMAT=off
# Vision / long requests (ms)
OLLAMA_FETCH_TIMEOUT_MS=900000
# PDF: treat page as text if at least this many chars from text layer
PDF_PAGE_MIN_TEXT_CHARS=50
# Financial extraction pipeline: max parallel vision OCR pages / parallel per-page LLM chains (default 5). Raise for remote APIs; lower for local Ollama/GPU.
# EXTRACTION_PDF_VISION_CONCURRENCY=5
# EXTRACTION_LLM_CONCURRENCY=5
# Optional caps (omit or unset = no limit). Large PDFs / text use more RAM and Ollama context.
# PDF_MAX_PAGES=50
# STRUCTURE_MAX_CHARS=50000
# Optional overrides for built-in extraction prompts (advanced)
# DEFAULT_VISION_PROMPT=
# DEFAULT_STRUCTURE_PROMPT=
# Upload limit (bytes) — multipart POST body (nginx/proxy may impose a lower limit).
UPLOAD_MAX_BYTES=104857600
# Direct-to-S3 uploads: `POST /api/files/upload-s3/init` + browser PUT + `POST …/complete` (see docs / S3 CORS).
# PRESIGNED_UPLOAD_MAX_BYTES=262144000
# PRESIGNED_PUT_TTL_SEC=900
# Jobs: cancel queued or processing extraction with POST /api/jobs/:id/cancel (frees pg-boss worker for the next job).

# --- OpenAI (optional; enables provider when OPENAI_API_KEY is set) ---
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_VISION_MODEL=gpt-4o
# OPENAI_STRUCTURE_MODEL=gpt-4o-mini

# --- Hugging Face (optional; enables provider when HUGGINGFACE_API_KEY is set) ---
# HUGGINGFACE_API_KEY=
# HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1
# Retries for transient HTTP (504 gateway, etc.) on chat/completions — extra attempts after first failure
# HUGGINGFACE_HTTP_MAX_RETRIES=4
# HUGGINGFACE_HTTP_RETRY_BASE_MS=2000
# HUGGINGFACE_VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
# HUGGINGFACE_STRUCTURE_MODEL=Qwen/Qwen3-VL-235B-A22B-Instruct:novita

# --- Amazon Bedrock (optional; enables when AWS_REGION + BEDROCK_* model IDs are set) ---
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# BEDROCK_VISION_MODEL=anthropic.claude-3-5-sonnet-20240620-v1:0
# BEDROCK_STRUCTURE_MODEL=anthropic.claude-3-5-sonnet-20240620-v1:0


# --- Firebase Admin / FCM mobile push (optional; web bell notifications work without this) ---
# Service account from Firebase console → Project settings → Service accounts → Generate new private key.
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional file fallback instead of the three vars above:
# FIREBASE_ADMIN_CREDENTIALS_PATH=config/firebase-admin.json
