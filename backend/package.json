{
  "name": "dhanbiz-backend",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "clean": "node ./node_modules/rimraf/bin.js dist",
    "build": "node ./node_modules/@nestjs/cli/bin/nest.js build",
    "start": "node dist/main.js",
    "dev": "node ./node_modules/@nestjs/cli/bin/nest.js start --watch --tsc -p tsconfig.build.json",
    "migrate": "npm run clean && npm run build && node dist/scripts/migrate.js",
    "customers:list": "npm run build && node dist/scripts/list-customers.js",
    "openapi:export": "npm run build && node dist/scripts/generate-openapi.js",
    "typeorm": "typeorm-ts-node-commonjs",
    "test:rbac": "node ./scripts/test-rbac.js",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1019.0",
    "@aws-sdk/client-s3": "^3.1037.0",
    "@aws-sdk/s3-request-presigner": "^3.1037.0",
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.22",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/typeorm": "^10.0.2",
    "@nestjs/websockets": "^10.4.22",
    "@nestjsx/crud": "^4.6.2",
    "@nestjsx/crud-typeorm": "^4.6.2",
    "@types/bcrypt": "^6.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.0",
    "archiver": "^8.0.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "exceljs": "^4.4.0",
    "firebase-admin": "^13.10.0",
    "multer": "^1.4.5-lts.2",
    "nestjs-cls": "^6.2.0",
    "nodemailer": "^8.0.7",
    "patch-package": "^8.0.1",
    "pdf-poppler": "^0.2.3",
    "pdfjs-dist": "^4.10.38",
    "pdfkit": "^0.18.0",
    "pg": "^8.20.0",
    "pg-boss": "^10.4.2",
    "playwright": "^1.49.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.28",
    "typeorm-transactional": "^0.5.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/archiver": "^7.0.0",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.19.37",
    "@types/pdfkit": "^0.17.6",
    "@types/swagger-ui-express": "^4.1.8",
    "typescript": "^5.9.3"
  }
}
