  "info": {
    "title": "doc-parser API",
    "description": "HTTP API for document parsing, extraction, jobs, and customers.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "name": "Authorization",
        "in": "header"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "you@example.com",
            "description": "Email for database-backed login (use with password)."
          },
          "username": {
            "type": "string",
            "example": "admin",
            "description": "Username for legacy env-based login (use with password)."
          },
          "password": {
            "type": "string",
            "example": "your-password",
            "description": "Password. Required with email or username when auth is enabled.",
            "format": "password"
          }
        }
      },
      "SignupDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "you@example.com",
            "description": "Account email (stored lowercased).",
            "format": "email"
          },
          "password": {
            "type": "string",
            "example": "minimum-8-chars",
            "description": "Password (minimum 8 characters).",
            "format": "password",
            "minLength": 8
          },
          "customerId": {
            "type": "string",
            "example": "00000000-0000-4000-8000-000000000001",
            "description": "Optional existing customers.id to associate the user."
          },
          "phoneNumber": {
            "type": "string",
            "example": "+15551234567",
            "description": "Optional phone number."
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "GetManyCustomerResponseDto": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Customer"
            }
          },
          "count": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "page": {
            "type": "number"
          },
          "pageCount": {
            "type": "number"
          }
        },
        "required": [
          "data",
          "count",
          "total",
          "page",
          "pageCount"
        ]
      },
      "Customer": {
        "type": "object",
        "properties": {}
      },
